%% Карта контекстов. Подписи на стрелках — только вид связи, чтобы карта читалась в любом просмотрщике.
%% Что передаётся по каждой связи и почему выбран такой вид — таблица «Связи контекстов» в docs/domain/event-storming.md
flowchart LR
    subgraph own["Остатки сладки"]
        booking["Бронирование и выдача<br/><i>основной контекст</i><br/>предложения, остаток, брони, коды выдачи"]
        bakeries["Пекарни<br/><i>поддерживающий</i><br/>пекарни, точки выдачи, сотрудники"]
        access["Доступ<br/><i>общего назначения</i><br/>учётные записи, вход"]
        notify["Уведомления<br/><i>поддерживающий</i><br/>подписки, напоминания<br/><b>v1.1</b>"]
        totals["Итоги<br/><i>поддерживающий</i><br/>наборы за период<br/><b>v1.1</b>"]
    end

    geo["Служба координат<br/><i>чужая система</i>"]
    max["MAX<br/><i>чужая система</i>"]
    pos["Касса пекарни<br/><i>чужая система</i>"]

    bakeries -->|"поставщик — потребитель"| booking
    access -->|"поставщик — потребитель"| booking
    booking -->|"открытая служба: события"| notify
    booking -->|"открытая служба: события"| totals
    bakeries -->|"уровень предотвращения<br/>искажений"| geo
    booking -->|"уровень предотвращения<br/>искажений"| geo
    notify -->|"уровень предотвращения<br/>искажений"| max
    bakeries -.->|"раздельные пути"| pos

    classDef core fill:#FBF0EC,stroke:#E2603A,color:#16202E
    classDef sup fill:#ECF6F4,stroke:#3E9E8F,color:#16202E
    classDef ext fill:#F1F3F6,stroke:#5B6472,color:#16202E
    class booking core
    class bakeries,access,notify,totals sup
    class geo,max,pos ext
