%% Соглашение об оформлении C4 — в docs/architecture/README.md
%% actor — действующее лицо; sys — наша система; ext — внешняя система
%% Элемент, которого ещё нет, помечается в подписи номером работы: <b>ЛР 6А</b>
flowchart TB
    buyer["Покупатель<br/><i>человек</i><br/>Ищет предложения рядом, бронирует, забирает по коду"]
    admin["Администратор пекарни<br/><i>человек</i><br/>Публикует остатки, видит брони на сегодня"]
    seller["Продавец<br/><i>человек</i><br/>Выдаёт наборы по коду"]
    operator["Оператор платформы<br/><i>человек: команда</i><br/>Заводит пекарни и сотрудников"]

    subgraph boundary["Остатки сладки"]
        system["Остатки сладки<br/><i>программная система</i><br/>Предложения остатков дня, брони с кодом выдачи, учёт выдачи и неявок"]
    end

    geo["Служба координат<br/><i>внешняя система</i><br/>Переводит адрес в координаты"]
    max["MAX<br/><i>внешняя система</i><br/>Мессенджер: бот уведомлений<br/><b>ЛР 6А</b>"]
    ci["Конвейер GitHub Actions<br/><i>внешняя система</i><br/>Проверяет и развёртывает<br/><b>ЛР 6Б</b>"]
    probe["Внешняя проверка работоспособности<br/><i>внешняя система</i><br/>Опрашивает готовность<br/><b>ЛР 7</b>"]

    buyer -->|"ищет и бронирует наборы<br/>HTTPS"| system
    admin -->|"публикует предложения, смотрит брони<br/>HTTPS"| system
    seller -->|"отмечает выдачу по коду<br/>HTTPS"| system
    operator -->|"заводит пекарню и сотрудников<br/>командная строка на сервере"| system
    system -->|"запрашивает координаты адреса<br/>HTTPS, JSON"| geo
    system -->|"отправляет уведомления и напоминания<br/>HTTPS, Bot API"| max
    max -->|"доставляет действия покупателя в боте<br/>HTTPS, вызов по адресу системы"| system
    ci -->|"развёртывает<br/>образ контейнера"| system
    probe -->|"опрашивает<br/>HTTP GET /health"| system

    classDef actor fill:#E8EEF7,stroke:#4A7DB5,color:#16202E
    classDef sys fill:#FBF0EC,stroke:#E2603A,color:#16202E
    classDef ext fill:#F1F3F6,stroke:#5B6472,color:#16202E
    class buyer,admin,seller,operator actor
    class system sys
    class geo,max,ci,probe ext
